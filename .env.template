# ========================================
# INSTAGRAM SCRAPER BACKEND - COMPLETE ENV TEMPLATE
# ========================================
# Copy this file to .env and fill in your values

# ---------- SERVER CONFIGURATION ----------
PORT=5002
NODE_ENV=development
LOG_LEVEL=info

# ---------- DATABASE ----------
# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# ---------- INSTAGRAM SCRAPING ----------
# Apify API token for Instagram scraping (required)
APIFY_API_TOKEN=your_apify_api_token_here

# ---------- AI ANALYSIS (NEW - TRIPLE FALLBACK) ----------
# Primary AI Model - DeepSeek-R1
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# First Fallback AI Model - Grok (X.AI)
GROK_API_KEY=your_grok_api_key_here

# Second Fallback AI Model - Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here

# ---------- CLOUDFLARE R2 (IMAGE STORAGE) ----------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=your_bucket_name
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ---------- REDIS (OPTIONAL - FOR QUEUE SYSTEM) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ---------- EXTERNAL SERVICES ----------
# Analyzer backend URL (no trailing slash!)
ANALYSIS_BACKEND_URL=http://localhost:5001
# Production example: https://analyzer.railway.app

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# API base URL
API_BASE_URL=http://localhost:5002

# ---------- BATCH PROCESSING (OPTIONAL) ----------
BATCH_SIZE=5
MAX_CONCURRENT_REQUESTS=3
DEPTH_BATCH_SIZE=10
DEPTH_MAX_CONCURRENT=2
MAX_RELATED_PER_PROFILE=50

# ========================================
# NOTES FOR DEPLOYMENT:
# ========================================
# 1. REQUIRED: MONGODB_URI, APIFY_API_TOKEN
# 2. AI MODELS: At least one API key recommended for AI analysis
# 3. REDIS: Optional, but required for queue features
# 4. CLOUDFLARE R2: Required for image CDN features
# 5. PORTS: Backend (5002), Analyzer (5001), Frontend (3000)
# ========================================