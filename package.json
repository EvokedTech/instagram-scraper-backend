{
  "name": "instagram-scraper",
  "version": "1.0.0",
  "description": "Instagram scraper with Node.js, Express, and MongoDB",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:no-redis": "cross-env REDIS_HOST=disabled node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:batch": "node src/scripts/testBatchProcessing.js",
    "test:related": "node src/scripts/testRelatedProfilesExtraction.js",
    "test:full": "node src/scripts/testFullPipeline.js",
    "test:depth": "node src/scripts/testDepthProcessing.js",
    "test:queue": "node src/scripts/testQueueSystem.js",
    "test:ai": "node scripts/testAIFallback.js",
    "test:models": "node scripts/quickTestModels.js"
  },
  "keywords": [
    "instagram",
    "scraper",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@google/genai": "^1.11.0",
    "apify-client": "^2.12.6",
    "axios": "^1.12.1",
    "bull": "^4.16.5",
    "bull-board": "^1.7.2",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.4",
    "helmet": "^7.1.0",
    "mongoose": "^7.6.3",
    "puppeteer": "^21.5.2",
    "redis": "^5.6.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
